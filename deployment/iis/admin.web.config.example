<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to Backend\admin\web.config. Bind this IIS site to loopback only.
     Backend\admin may be the root of a dedicated site or an IIS application at
     any path (for example /admin or /internal-admin). Every rule below is
     relative to this directory and index.php derives its URLs from SCRIPT_NAME,
     so the public path is chosen in IIS rather than in this file. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="false" />
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="Strict-Transport-Security" />
        <remove name="X-Content-Type-Options" />
        <remove name="Referrer-Policy" />
        <remove name="X-Frame-Options" />
        <remove name="Permissions-Policy" />
        <remove name="Content-Security-Policy" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
    <!-- GENERIC_ADMIN_ENABLED=1 belongs only to the Admin FastCGI boundary.
         Register a dedicated FastCGI application whose arguments match the
         scriptProcessor below, so API and SQL Parser workers never inherit it:
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=admin']" /commit:apphost
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=admin'].environmentVariables.[name='GENERIC_ADMIN_ENABLED',value='1']" /commit:apphost
         Production mode must be explicit for this boundary as well:
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=admin'].environmentVariables.[name='GENERIC_APP_ENV',value='production']" /commit:apphost
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=admin'].environmentVariables.[name='PHPRC',value='C:\PHP']" /commit:apphost -->
    <handlers>
      <remove name="GenericSqlAdminPhpFastCgi" />
      <add name="GenericSqlAdminPhpFastCgi" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe|-d generic_sql_api.boundary=admin" resourceType="File"
           requireAccess="Script" />
    </handlers>
    <rewrite>
      <rules>
        <clear />
        <rule name="Allow Admin API" stopProcessing="true">
          <match url="^api\.php$" />
          <action type="None" />
        </rule>
        <rule name="Allow Admin assets" stopProcessing="true">
          <match url="^assets/(?:admin\.css|admin\.js|service-controls\.css)$" />
          <action type="None" />
        </rule>
        <!-- Relative rewrite target: resolves to this application's index.php
             whatever public path the Admin application is mounted at. -->
        <rule name="Route Admin pages" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <ipSecurity allowUnlisted="false">
        <clear />
        <add ipAddress="127.0.0.1" allowed="true" />
        <add ipAddress="::1" allowed="true" />
      </ipSecurity>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".config" />
          <remove fileExtension=".env" />
          <remove fileExtension=".ini" />
          <remove fileExtension=".json" />
          <remove fileExtension=".log" />
          <remove fileExtension=".bak" />
          <remove fileExtension=".backup" />
          <remove fileExtension=".old" />
          <remove fileExtension=".tmp" />
          <remove fileExtension=".lock" />

          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".backup" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
