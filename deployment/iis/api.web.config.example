<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to Backend\api\web.config after registering C:\PHP\php-cgi.exe with IIS FastCGI. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="Strict-Transport-Security" />
        <remove name="X-Content-Type-Options" />
        <remove name="Referrer-Policy" />
        <remove name="X-Frame-Options" />
        <remove name="Permissions-Policy" />
        <remove name="Content-Security-Policy" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Content-Security-Policy" value="default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" />
      </customHeaders>
    </httpProtocol>
    <!-- Production mode must be explicit for the API boundary; it is never
         inherited from a global default. Register a dedicated FastCGI application
         whose arguments match the scriptProcessor below and set its environment:
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=api']" /commit:apphost
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=api'].environmentVariables.[name='GENERIC_APP_ENV',value='production']" /commit:apphost
         appcmd.exe set config -section:system.webServer/fastCgi /+"[fullPath='C:\PHP\php-cgi.exe',arguments='-d generic_sql_api.boundary=api'].environmentVariables.[name='PHPRC',value='C:\PHP']" /commit:apphost
         Add other server-side application variables to this registration only.
         Never add GENERIC_ADMIN_ENABLED here. -->
    <handlers>
      <remove name="GenericSqlApiPhpFastCgi" />
      <add name="GenericSqlApiPhpFastCgi" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe|-d generic_sql_api.boundary=api" resourceType="File"
           requireAccess="Script" />
    </handlers>
    <rewrite>
      <rules>
        <clear />
        <rule name="Allow API entry points" stopProcessing="true">
          <match url="^(?:index|health)\.php$" />
          <action type="None" />
        </rule>
        <rule name="Route API root" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.php" />
        </rule>
        <rule name="Route API health" stopProcessing="true">
          <match url="^health/(live|ready)$" />
          <action type="Rewrite" url="health.php" />
        </rule>
        <rule name="Reject non-entry-point paths" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".config" />
          <remove fileExtension=".env" />
          <remove fileExtension=".ini" />
          <remove fileExtension=".json" />
          <remove fileExtension=".log" />
          <remove fileExtension=".sql" />
          <remove fileExtension=".bak" />
          <remove fileExtension=".backup" />
          <remove fileExtension=".old" />
          <remove fileExtension=".tmp" />
          <remove fileExtension=".lock" />

          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".backup" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
       </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
</configuration>