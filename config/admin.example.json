{
    "version": 6,
    "server": {
        "apiPortMinimum": 8000,
        "apiPortMaximum": 8100,
        "parserPortMinimum": 8101,
        "parserPortMaximum": 8199,
        "adminPort": 8090,
        "bindAddress": "127.0.0.1"
    },
    "cors": {
        "allowedOrigins": [
            "http://127.0.0.1:5173",
            "http://localhost:5173",
            "http://127.0.0.1:5314",
            "http://localhost:5314",
            "http://127.0.0.1:5341",
            "http://localhost:5341"
        ],
        "credentialsEnabled": true,
        "allowedMethods": [
            "POST",
            "OPTIONS"
        ]
    },
    "authentication": {
        "mode": "session"
    },
    "runtime": {
        "query": {
            "timeoutSeconds": 45
        },
        "rateLimit": {
            "api": {
                "enabled": true,
                "requests": 600,
                "windowSeconds": 60
            },
            "login": {
                "enabled": true,
                "maximumAttempts": 5,
                "windowSeconds": 900,
                "lockoutSeconds": 300
            }
        },
        "session": {
            "idleTimeoutSeconds": 1800,
            "absoluteTimeoutSeconds": 28800
        },
        "request": {
            "maxBodyBytes": 1048576,
            "defaultPageSize": 25,
            "maxPageSize": 1000
        }
    },
    "backup": {
        "enabled": false,
        "frequency": "daily",
        "time": "02:00",
        "retention": 30
    }
}
